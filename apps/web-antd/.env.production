VITE_BASE=/

# 接口地址（ypbin-admin 后端，部署时按实际环境修改）
VITE_GLOB_API_URL=/api

# 埋点上报地址（ypbin-starter-tracking 的采集端点）。
# 链路：nginx 的 location /api/ 去掉 /api → 网关 Path=/system/** 再去掉 /system → 服务端 /tracking/ingest。
# 留空表示不启用埋点：SDK 会打印一条告警而不是静默不采集。
VITE_GLOB_TRACK_URL=/api/system/tracking/ingest

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
