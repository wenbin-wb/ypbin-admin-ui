# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址（走 vite 代理转发到 ypbin 后端，见 vite.config.mts）
VITE_GLOB_API_URL=/api

# 埋点上报地址；留空表示不启用埋点（SDK 会告警且不采集）。
# 需要联调时填 /api/system/tracking/ingest —— 走 vite 代理（同样会去掉 /api 前缀）到本地网关，
# 前提是本地后端已开启采集端点（ypbin.tracking.enabled 与 ingest-enabled 均为 true），
# 否则每批上报会打一条「上报失败」告警（不重试、不阻塞）。
VITE_GLOB_TRACK_URL=

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭（对接真实 ypbin 后端，关闭）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true


